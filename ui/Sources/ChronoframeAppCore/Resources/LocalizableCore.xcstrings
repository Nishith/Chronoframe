          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Chronoframe no pudo copiar este archivo, por lo que el origen no fue modificado. Origen: %@. Destino: %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
