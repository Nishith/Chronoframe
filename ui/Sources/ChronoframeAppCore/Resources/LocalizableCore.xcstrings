          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo encontrar el recibo de reversión seleccionado. Puede haber sido movido o eliminado. Recibo: %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
