    },
    "This item stopped being a regular file, so Chronoframe didn't read it.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This item stopped being a regular file, so Chronoframe didn't read it."
