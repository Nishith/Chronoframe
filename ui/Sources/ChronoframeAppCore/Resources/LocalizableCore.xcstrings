            "state": "translated",
            "value": "1 Ordner"
          }
        }
      }
    },
    "A file already exists at the new location, so Chronoframe left the original in place. Destination: %@.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A file already exists at the new location, so Chronoframe left the original in place. Destination: %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya existe un archivo en la nueva ubicación, por lo que Chronoframe dejó el original en su lugar. Destino: %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un fichier existe déjà à l'emplacement indiqué. Chronoframe a donc laissé l'original sur place. Destination : %@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Am neuen Ort existiert bereits eine Datei, daher hat Chronoframe das Original unangetastet gelassen. Ziel: %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しい場所にファイルが既に存在するため、Chronoframeはオリジナルをそのままにしました。コピー先: %@。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "新位置已存在同名文件，因此 Chronoframe 将原文件保留在原处。目标：%@。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un file esiste già nella nuova posizione, quindi Chronoframe ha lasciato l'originale intatto. Destinazione: %@."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um arquivo já existe no novo local, portanto, o Chronoframe deixou o original no lugar. Destino: %@."
          }
        }
      }
    },
    "A file disappeared before Chronoframe could move it. File: %@.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A file disappeared before Chronoframe could move it. File: %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un archivo desapareció antes de que Chronoframe pudiera moverlo. Archivo: %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un fichier a disparu avant que Chronoframe ne puisse le déplacer. Fichier : %@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Datei ist verschwunden, bevor Chronoframe sie verschieben konnte. Datei: %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Chronoframeが移動する前にファイルが消失しました。ファイル: %@。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Chronoframe 移动文件之前，该文件已消失。文件：%@。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un file è scomparso prima che Chronoframe potesse spostarlo. File: %@."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um arquivo desapareceu antes que o Chronoframe pudesse movê-lo. Arquivo: %@."
          }
        }
      }
    },
    "A file or folder Chronoframe needs is no longer available. Reconnect the drive or choose the folder again, then try again.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A file or folder Chronoframe needs is no longer available. Reconnect the drive or choose the folder again, then try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un archivo o carpeta que Chronoframe necesita ya no está disponible. Reconecta la unidad o elige la carpeta de nuevo, luego inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un fichier ou dossier nécessaire à Chronoframe n'est plus disponible. Rebranchez le lecteur ou choisissez à nouveau le dossier, puis réessayez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine benötigte Datei oder ein Ordner ist nicht mehr verfügbar. Verbinde das Laufwerk neu oder wähle den Ordner erneut aus, und versuche es dann nochmal."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Chronoframeが必要とするファイルまたはフォルダーが利用できなくなりました。ドライブを再接続するかフォルダーを再選択し、もう一度お試しください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Chronoframe 所需的文件或文件夹已不可用。请重新连接驱动器或重新选择文件夹，然后重试。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un file o una cartella di cui Chronoframe ha bisogno non è più disponibile. Riconnetti l'unità o scegli nuovamente la cartella, quindi riprova."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um arquivo ou pasta de que o Chronoframe precisa não está mais disponível. Reconecte o disco ou escolha a pasta novamente e tente novamente."
          }
        }
      }
    },
    "Accept All Safe": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
