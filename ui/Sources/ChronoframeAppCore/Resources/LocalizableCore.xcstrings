          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La ricevuta di ripristino selezionata non è stata trovata. Potrebbe essere stata spostata o eliminata. Ricevuta: %@."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O recibo de reversão selecionado não pôde ser encontrado. Pode ter sido movido ou excluído. Recibo: %@."
