    "Chronoframe stopped the import because it couldn't save its progress. The drive holding its staging folder may be full. %@ of %@ items are ready and were kept. Free up space, then resume. Your Photos library was not changed.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Chronoframe stopped the import because it couldn't save its progress. The drive holding its staging folder may be full. %@ of %@ items are ready and were kept. Free up space, then resume. Your Photos library was not changed."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Chronoframe hat den Import gestoppt, weil der Fortschritt nicht gespeichert werden konnte. Das Laufwerk mit dem Zwischenordner ist möglicherweise voll. %1$@ von %2$@ Objekten sind bereit und wurden aufbewahrt. Schaffe Speicherplatz und setze dann fort. Deine Fotos-Mediathek wurde nicht verändert."
          }
        }
      }
    },
    "Chronoframe couldn't read the selected items from Photos, so there is nothing to import. Your Photos library was not changed.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Chronoframe couldn't read the selected items from Photos, so there is nothing to import. Your Photos library was not changed."
