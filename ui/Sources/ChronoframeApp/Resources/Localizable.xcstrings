        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein gespeichertes Profil enthält einen Ordner. Lass diese Liste unverändert (Chronoframe merkt sie sich), oder entferne die zusätzlichen Ordner, um ein Profil zu speichern."
          }
        }
      }
    },
