        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Freigeschaltet"
          }
        }
      }
    },
    "This build is not distributed through the App Store, so it has no purchase to check. Every feature is available, with no limits." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
