            "state" : "translated",
            "value" : "Chronoframe hat den Zugriff auf seine Testnutzungsdaten verloren. Versuche es erneut."
          }
        }
      }
    },
    "This destination is on a network drive. Chronoframe can't guarantee safe results if it runs from more than one Mac at the same time — keep it to a single machine." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Ziel liegt auf einem Netzlaufwerk. Chronoframe kann keine sicheren Ergebnisse garantieren, wenn es gleichzeitig auf mehreren Macs ausgeführt wird. Verwende dafür immer nur einen Mac."
          }
        }
      }
    },
    "The %@ folder is no longer available. Reconnect the drive or choose the %@ folder again. Path: %@." : {
      "localizations" : {
        "de" : {
