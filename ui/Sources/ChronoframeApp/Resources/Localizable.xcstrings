    "Chronoframe will move every recognised file in the destination into the %@ layout. Originals are not deleted, but files will appear at new paths. Open Preview & Copy to track progress." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chronoframe will move every recognised file in the destination into the %@ layout. Originals are not deleted, but files will appear at new paths. Open Preview & Copy to track progress."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chronoframe verschiebt jede erkannte Datei im Ziel in die Struktur %@. Originale werden nicht gelöscht, die Dateien erhalten jedoch neue Pfade. Öffne „Vorschau & Kopieren“, um den Fortschritt zu verfolgen."
          }
        }
      }
    },
