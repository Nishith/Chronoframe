        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für diese Datei konnte keine Vorschau erstellt werden."
          }
        }
      }
    },
    "A receipt you can undo from History will be written to .organize_logs before trashing, allowing full restore." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A receipt you can undo from History will be written to .organize_logs before trashing, allowing full restore."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vor dem Ablegen im Papierkorb wird in .organize_logs ein Beleg gespeichert. Damit kannst du alles über den Verlauf wiederherstellen."
          }
        }
      }
    },
    "A saved profile holds one folder. Keep this list as it is (Chronoframe remembers it), or remove the extra folders to save a profile." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A saved profile holds one folder. Keep this list as it is (Chronoframe remembers it), or remove the extra folders to save a profile."
