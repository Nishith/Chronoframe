          }
        }
      }
    },
    "Chronoframe could not read this revert receipt. Choose a different receipt or run a new transfer." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chronoframe konnte diesen Wiederherstellungsbeleg nicht lesen. Wähle einen anderen Beleg oder führe einen neuen Transfer durch."
          }
        }
      }
    },
    "Chronoframe could not refresh History. Check that the destination drive is connected, then try again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chronoframe konnte den Verlauf nicht aktualisieren. Prüfe, ob das Ziellaufwerk angeschlossen ist, und versuche es erneut."
          }
        }
      }
    },
    "Chronoframe could not remove this copied file during revert, so it was left in place. File: %@." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
