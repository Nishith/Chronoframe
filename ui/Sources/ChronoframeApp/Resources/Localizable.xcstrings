            "value" : "Kostenlos testen"
          }
        }
      }
    },
    "Chronoframe could not read its record of how much of the free trial you have used, so it cannot show what is left. Unlocking Chronoframe removes the limit entirely." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
