    "Reorganize is not supported by this engine." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Engine unterstützt die Neuorganisation nicht."
          }
        }
      }
    },
    "Your purchase needs approval before it can finish. Chronoframe will unlock automatically once it's approved." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Kauf muss genehmigt werden, bevor er abgeschlossen werden kann. Chronoframe wird nach der Genehmigung automatisch freigeschaltet."
          }
        }
      }
    },
    "Chronoframe couldn't verify that purchase on this Mac. Don't buy again — choose Restore Purchases first, and contact support if it still doesn't unlock." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chronoframe konnte diesen Kauf auf diesem Mac nicht bestätigen. Kaufe nicht erneut. Wähle zuerst „Käufe wiederherstellen“ und kontaktiere den Support, falls die Freischaltung weiterhin ausbleibt."
          }
        }
      }
    },
    "Chronoframe couldn't load the unlock from the App Store. Check your connection and try again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chronoframe konnte die Freischaltung nicht aus dem App Store laden. Prüfe deine Verbindung und versuche es erneut."
          }
        }
      }
    },
    "That purchase couldn't be completed. Check your connection and try again, or use Restore Purchases if you've already bought the unlock." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Kauf konnte nicht abgeschlossen werden. Prüfe deine Verbindung und versuche es erneut oder verwende „Käufe wiederherstellen“, wenn du die Freischaltung bereits gekauft hast."
          }
        }
      }
    },
    "Chronoframe couldn't reach the App Store to restore your purchase. Check your connection and try again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chronoframe konnte den App Store nicht erreichen, um deinen Kauf wiederherzustellen. Prüfe deine Verbindung und versuche es erneut."
          }
        }
      }
    },
    "No previous purchase was found for this Apple Account. If you bought Chronoframe with a different account, sign in with that one." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für diesen Apple Account wurde kein früherer Kauf gefunden. Wenn du Chronoframe mit einem anderen Account gekauft hast, melde dich mit diesem an."
          }
        }
      }
    },
    "Chronoframe couldn't reach the App Store to check your purchase. Your access is unchanged — try again once you're back online." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chronoframe konnte den App Store nicht erreichen, um deinen Kauf zu prüfen. Dein Zugriff bleibt unverändert. Versuche es erneut, sobald du wieder online bist."
          }
        }
      }
    },
    "The App Store's response couldn't be verified on this Mac. Try again, and contact support if it keeps happening." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Antwort des App Store konnte auf diesem Mac nicht bestätigt werden. Versuche es erneut und kontaktiere den Support, falls das Problem bestehen bleibt."
          }
        }
      }
    },
    "The library or mirror folder changed since this action started, so Chronoframe stopped to avoid working on the wrong folder. Nothing was changed." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
