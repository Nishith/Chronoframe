    },
    "Chronoframe could not finish. Your original files were left untouched." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chronoframe could not finish. Your original files were left untouched."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chronoframe konnte den Vorgang nicht abschließen. Deine Originaldateien blieben unangetastet."
          }
        }
      }
    },
    "Chronoframe could not finish. Your originals were not changed. Check that both folders are available, then try again." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chronoframe could not finish. Your originals were not changed. Check that both folders are available, then try again."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chronoframe konnte den Vorgang nicht abschließen. Deine Originale wurden nicht verändert. Prüfe, ob beide Ordner verfügbar sind, und versuche es erneut."
          }
        }
      }
    },
    "Chronoframe couldn't save that choice. Your library and the assessment weren't changed. Try again." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chronoframe couldn't save that choice. Your library and the assessment weren't changed. Try again."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chronoframe konnte diese Entscheidung nicht speichern. Deine Mediathek und die Prüfung wurden nicht verändert. Versuche es erneut."
          }
        }
      }
    },
    "Chronoframe creates dated folders here and keeps a receipt of each copy so you can undo it from History." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chronoframe creates dated folders here and keeps a receipt of each copy so you can undo it from History."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chronoframe erstellt hier datierte Ordner und speichert für jeden Kopiervorgang einen Beleg, damit du ihn über den Verlauf rückgängig machen kannst."
          }
        }
      }
    },
    "Chronoframe is a darkroom for time. Point it at a folder of photos and videos and it organizes a clean, dated copy at your destination — never moving, never overwriting your originals." : {
      "comment" : "A description of the functionality of Chronoframe.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chronoframe ist eine Dunkelkammer für deine Zeit. Wähle einen Ordner mit Fotos und Videos aus, und Chronoframe erstellt eine sauber nach Datum sortierte Kopie am Zielort – deine Originale werden niemals bewegt oder überschrieben."
          }
        }
      }
    },
    "Chronoframe is a native macOS app built with Swift, SwiftUI, AppKit, Vision, Quick Look, and SQLite." : {
      "comment" : "A description of Chronoframe.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chronoframe ist eine native macOS-App, entwickelt mit Swift, SwiftUI, AppKit, Vision, Quick Look und SQLite."
          }
        }
      }
    },
    "Chronoframe is checking your folders before it starts." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
