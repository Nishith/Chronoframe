      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ Pfad: %2$@."
          }
        }
      }
    },
    "A file already exists at the new location, so Chronoframe left the original in place. Destination: %@." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Am neuen Ort existiert bereits eine Datei, daher hat Chronoframe das Original unangetastet gelassen. Ziel: %@."
          }
        }
      }
    },
    "A file disappeared before Chronoframe could move it. File: %@." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Datei ist verschwunden, bevor Chronoframe sie verschieben konnte. Datei: %@."
          }
        }
      }
    },
    "A file or folder Chronoframe needs is no longer available. Reconnect the drive or choose the folder again, then try again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine benötigte Datei oder ein Ordner ist nicht mehr verfügbar. Verbinde das Laufwerk neu oder wähle den Ordner erneut aus, und versuche es dann nochmal."
          }
        }
      }
    },
    "Accept All Suggestions" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle Vorschläge akzeptieren"
          }
        }
      }
    },
    "Add a folder to organize before the next preview." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Füge vor der nächsten Vorschau einen Ordner zum Organisieren hinzu."
          }
        }
      }
    },
    "Approve Group" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gruppe genehmigen"
          }
        }
      }
    },
    "Choose a folder on a network share. For folders on this Mac, use Deduplicate." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle einen Ordner auf einer Netzwerkfreigabe. Verwende für Ordner auf diesem Mac „Duplikate entfernen“."
          }
        }
      }
    },
    "Choose a folder on this Mac or an attached drive. Deduplicate can't move files on a network share to the Trash safely yet, so nothing was changed." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle einen Ordner auf diesem Mac oder einem angeschlossenen Laufwerk. „Duplikate entfernen“ kann Dateien auf einer Netzwerkfreigabe noch nicht sicher in den Papierkorb legen. Deshalb wurde nichts geändert."
          }
        }
      }
    },
    "Choose a folder on this Mac or an attached drive. Deduplicate can't move files on a network share to the Trash safely yet, so nothing was changed. For a NAS, use NAS Library." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle einen Ordner auf diesem Mac oder einem angeschlossenen Laufwerk. „Duplikate entfernen“ kann Dateien auf einer Netzwerkfreigabe noch nicht sicher in den Papierkorb legen. Deshalb wurde nichts geändert. Verwende für ein NAS „NAS-Mediathek“."
          }
        }
      }
    },
    "Choose both a source folder and a destination folder before starting." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle vor dem Start sowohl einen Quellordner als auch einen Zielordner aus."
          }
        }
      }
    },
    "Chronoframe can't use this folder. Choose a regular folder on a network share, not a link. Nothing was changed." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chronoframe kann diesen Ordner nicht verwenden. Wähle einen regulären Ordner auf einer Netzwerkfreigabe statt eines Links. Es wurde nichts geändert."
          }
        }
      }
    },
    "Chronoframe copied this file but could not verify the copy, so the destination copy was removed and the source was left untouched. Source: %@. Destination: %@." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chronoframe hat diese Datei kopiert, konnte die Kopie aber nicht überprüfen. Die Zielkopie wurde entfernt und die Quelle blieb unangetastet. Quelle: %@. Ziel: %@."
          }
        }
      }
    },
    "Chronoframe could not check this file, so it skipped it. File: %@." : {
      "localizations" : {
        "de" : {
