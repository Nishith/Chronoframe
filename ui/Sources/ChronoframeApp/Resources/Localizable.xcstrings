    "Chronoframe operates inside a secure OS-level sandbox. It only accesses the specific folders you explicitly select." : {
      "comment" : "A description of how Chronoframe operates.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chronoframe arbeitet in einer sicheren macOS-Sandbox und greift ausschließlich auf die Ordner zu, die du explizit auswählst."
          }
        }
      }
    },
    "Chronoframe reads this folder and never changes what is in it." : {
      "extractionState" : "manual",
      "localizations" : {
