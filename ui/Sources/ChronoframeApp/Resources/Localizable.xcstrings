          }
        }
      }
    },
    "Chronoframe will move the files that duplicate cleanup sent to the Trash back to their original locations. Files that have since been emptied from the Trash cannot be restored.\n\nReceipt: %@" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chronoframe will move the files that duplicate cleanup sent to the Trash back to their original locations. Files that have since been emptied from the Trash cannot be restored.\n\nReceipt: %@"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chronoframe verschiebt die bei der Duplikatbereinigung in den Papierkorb gelegten Dateien an ihre ursprünglichen Speicherorte zurück. Bereits aus dem Papierkorb entfernte Dateien können nicht wiederhergestellt werden.\n\nBeleg: %@"
          }
        }
      }
    },
    "Chronoframe will move the files this reorganize changed back to their previous locations, but only if their contents still match the receipt.\n\nReceipt: %@" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chronoframe will move the files this reorganize changed back to their previous locations, but only if their contents still match the receipt.\n\nReceipt: %@"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chronoframe verschiebt die bei dieser Neuordnung geänderten Dateien an ihre vorherigen Speicherorte zurück, jedoch nur, wenn ihr Inhalt noch mit dem Beleg übereinstimmt.\n\nBeleg: %@"
          }
        }
      }
    },
    "Chronoframe will remove the files this receipt copied, but only if their contents still match the original copy. Files modified after the original copy will be preserved.\n\nReceipt: %@" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chronoframe will remove the files this receipt copied, but only if their contents still match the original copy. Files modified after the original copy will be preserved.\n\nReceipt: %@"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chronoframe entfernt die laut diesem Beleg kopierten Dateien, jedoch nur, wenn ihr Inhalt noch mit der ursprünglichen Kopie übereinstimmt. Seit dem ursprünglichen Kopiervorgang veränderte Dateien werden behalten.\n\nBeleg: %@"
          }
        }
      }
    },
