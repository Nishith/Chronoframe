            "state" : "translated",
            "value" : "%1$@ %2$@"
          }
        }
      }
    },
    "%@ (%@)" : {
      "comment" : "A row in a segmented picker that filters clusters by confidence level. The label shows the filter name and the count of clusters that match the filter.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ (%2$@)"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ (%2$@)"
          }
        }
      }
    },
    "%@ across %@ from %@." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ across %@ from %@."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ in %@ vom %@."
          }
        }
      }
    },
    "%@ and %@ saved %@. Scanning again restores them for files that haven't changed. Nothing is moved to the Trash until you review and confirm." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ and %@ saved %@. Scanning again restores them for files that haven't changed. Nothing is moved to the Trash until you review and confirm."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ und %@ wurden am %@ gespeichert. Ein erneuter Scan stellt sie für unveränderte Dateien wieder her. Erst nach deiner Prüfung und Bestätigung wird etwas in den Papierkorb gelegt."
          }
        }
      }
    },
    "%@ copied" : {
      "comment" : "A label that shows the number of files that were copied from a source.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ kopiert"
