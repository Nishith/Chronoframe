          }
        }
      }
    },
    "Your free allowance is used up. Unlock Chronoframe to keep organizing." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein kostenloses Kontingent ist aufgebraucht. Schalte Chronoframe frei, um weiter zu organisieren."
          }
